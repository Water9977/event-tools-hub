---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);
const siteName = 'Event Tools';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<title>{title}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<script is:inline>
			// Dark mode: apply before paint to avoid flash-of-wrong-theme
			const stored = localStorage.getItem('theme');
			const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			if (stored === 'dark' || (!stored && prefersDark)) {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="min-h-screen flex flex-col bg-bg text-text">
		<header class="border-b border-border bg-surface">
			<nav class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
				<a href="/" class="font-extrabold text-lg text-text hover:text-primary hover:no-underline">
					Event<span class="font-medium text-text-muted">Tools</span>
				</a>
				<div class="flex items-center gap-6 text-sm font-semibold">
					<a href="/" class="text-text hover:text-primary hover:no-underline">All Tools</a>
					<button
						id="theme-toggle"
						type="button"
						aria-label="Toggle dark mode"
						class="rounded-md border border-border px-2 py-1 text-xs font-semibold text-text-muted hover:text-primary hover:border-primary"
					>
						<span class="dark:hidden">Dark</span>
						<span class="hidden dark:inline">Light</span>
					</button>
				</div>
			</nav>
		</header>

		<main class="flex-1">
			<slot />
		</main>

		<footer class="border-t border-border bg-surface mt-16">
			<div class="max-w-5xl mx-auto px-4 py-8 flex flex-col gap-4">
				<p class="text-sm text-text-muted max-w-xl">
					Event Tools is a free, independently-run set of calculators and planners. No account,
					no data collection beyond anonymized analytics — every tool runs in your browser. A
					companion project to
					<a href="https://eventrentalcosts.com" target="_blank" rel="noopener">EventRentalCosts.com</a>.
				</p>
				<div class="flex flex-wrap items-center justify-between gap-4 text-sm">
					<div class="flex gap-4 font-semibold text-text-muted">
						<a href="/about" class="hover:text-primary hover:no-underline">About</a>
						<a href="/contact" class="hover:text-primary hover:no-underline">Contact</a>
						<a href="/privacy-policy" class="hover:text-primary hover:no-underline">Privacy Policy</a>
						<a href="/terms" class="hover:text-primary hover:no-underline">Terms</a>
					</div>
					<p class="text-xs text-text-muted">&copy; {new Date().getFullYear()} Event Tools</p>
				</div>
			</div>
		</footer>

		<script is:inline>
			document.getElementById('theme-toggle')?.addEventListener('click', () => {
				const isDark = document.documentElement.classList.toggle('dark');
				localStorage.setItem('theme', isDark ? 'dark' : 'light');
			});
		</script>
	</body>
</html>
