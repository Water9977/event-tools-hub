---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found | Event Tools" description="This page doesn't exist." noindex={true}>
	<div class="max-w-3xl mx-auto px-4 py-24 text-center">
		<h1 class="text-4xl font-bold mb-4">404 — Page Not Found</h1>
		<p class="text-text-muted mb-8">
			That page doesn't exist, or it may have moved.
		</p>
		<a href="/" class="inline-block rounded-md btn px-5 py-2.5 font-medium hover:opacity-90">
			Back to All Tools
		</a>
	</div>
</Layout>
